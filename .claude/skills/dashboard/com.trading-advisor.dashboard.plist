<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd user agent for the Trading Advisor dashboard control server.

  Install:
    cp .claude/skills/dashboard/com.trading-advisor.dashboard.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.trading-advisor.dashboard.plist
  Stop / uninstall:
    launchctl unload -w ~/Library/LaunchAgents/com.trading-advisor.dashboard.plist
  Restart (e.g. after editing server.py):
    launchctl kickstart -k gui/$(id -u)/com.trading-advisor.dashboard

  KeepAlive restarts the server if it EXITS/crashes. It does NOT catch a
  process that is alive-but-wedged (the 2026-06-15 large-response hang) — if the
  dashboard goes empty while the process is still running, kickstart -k it.
  Paths are absolute and machine-specific to this checkout.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trading-advisor.dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/aiagent/Documents/Claude/Projects/Trading Advisor/.claude/skills/dashboard/server.py</string>
        <string>--lan</string>
        <string>--port</string>
        <string>8787</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aiagent/Documents/Claude/Projects/Trading Advisor</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/aiagent/Documents/Claude/Projects/Trading Advisor/.claude/cache/dashboard/server.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/aiagent/Documents/Claude/Projects/Trading Advisor/.claude/cache/dashboard/server.out</string>
</dict>
</plist>
