<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kenson.trading-advisor-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/aiagent/Documents/Claude/Projects/Trading Advisor/scripts/sync-backup.sh</string>
    </array>
    <!-- Run every 3600 seconds (1 hour). Adjust to taste — e.g. 1800 = 30 min, 14400 = 4h. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <!-- Also run once immediately when the agent is loaded -->
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/aiagent/Documents/Claude/Projects/Trading Advisor/.git/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aiagent/Documents/Claude/Projects/Trading Advisor/.git/launchd-stderr.log</string>
</dict>
</plist>
