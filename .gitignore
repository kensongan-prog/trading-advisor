# Secrets — never commit
.env
**/.env
*.key
*.pem

# Personal trading data — real records stay LOCAL, never in the repo.
# Templates (*.example.md) are tracked so the project still builds + replicates;
# copy them to the real filenames on a fresh clone. See PROJECT_LOG.md.
/watchlist.md
/portfolio.md
/risk_params.json
/journal/*.md
!/journal/README.md

# Python
__pycache__/
*.pyc
.venv/
.venv-playwright/
venv/

# Playwright dashboard screenshots (regenerated on demand by snap.py)
snaps/

# Local launch config (preview-tool experiments, not source-of-truth)
.claude/launch.json

# OS
.DS_Store

# Dashboard build output + cache
dashboard.html
.claude/cache/

# Claude runtime artifacts
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json

# Agent-tooling mirrors — some harnesses auto-copy .claude/skills/ into a
# parallel .agents/skills/ tree. Identical content, duplicated; not source-of-truth.
.agents/
